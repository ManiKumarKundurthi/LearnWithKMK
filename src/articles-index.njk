---
layout: base.njk
title: All Articles
permalink: /articles/
---
<a href="{{ '/' | url }}" class="back-link">&larr; home</a>

<header class="article-header">
  <h1 class="article-title">All Articles</h1>
</header>

{% if collections.tagList.length %}
<div class="tag-filter">
  {% for tag in collections.tagList %}
    <a href="{{ ['/tags/', tag, '/'] | join | url }}" class="entry-tag">{{ tag | capitalize }}</a>
  {% endfor %}
</div>
{% endif %}

{% set articleList = collections.articles %}
{% set totalCount = collections.articles.length %}
{% set offset = 0 %}
{% include "partials/article-list.njk" %}
