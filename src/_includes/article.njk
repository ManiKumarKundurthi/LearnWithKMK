---
layout: base.njk
templateClass: article
---
<a href="{{ '/' | url }}" class="back-link">&larr; all articles</a>

<header class="article-header">
  <div class="article-meta">
    <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    {% if tags %}
      <span class="meta-separator">|</span>
      {% for tag in tags %}
        {% if tag != "articles" %}<a href="{{ ['/tags/', tag, '/'] | join | url }}" class="entry-tag">{{ tag | capitalize }}</a>{% endif %}
      {% endfor %}
    {% endif %}
    <span class="meta-separator">|</span>
    <span class="reading-time">{{ content | readingTime }}</span>
  </div>

  <h1 class="article-title">{{ title }}</h1>

  <div class="article-author">Author: KMK</div>

  <button class="share-btn" type="button" data-share-btn>
    <span class="share-label">Share</span>
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
  </button>
</header>

<article class="prose">
{{ content | safe }}
</article>
