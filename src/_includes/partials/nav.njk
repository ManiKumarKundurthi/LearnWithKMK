<header class="site-header">
  <div class="shell nav-container">
    <div class="nav-left">
      <a href="{{ '/' | url }}" class="site-mark">{{ site.title }}</a>
    </div>

    <div class="nav-right">
      <nav class="site-nav">
        {% for item in site.nav %}
          <a href="{{ item.url | url }}" class="btn-pill" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.text | capitalize }}</a>
        {% endfor %}
      </nav>

      <!-- Old right buttons commented out for future reference -->
      <!--
      <a href="#" class="btn-pill">Check my Projects</a>
      <a href="#" class="btn-pill">GitHub Repo</a>
      -->
    </div>
  </div>
</header>
